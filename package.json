{
  "name": "composer",
  "version": "0.3.2",
  "description": "Notion-style block handle (+ insert menu, block actions) and a right-edge document outline for Obsidian.",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "release:check": "pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "author": "Mario Miletta",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.4",
    "@floating-ui/dom": "^1.6.13",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
